# Production & Local Environment Variables Example Config
# Copy this file to '.env' and fill in your actual production/staging credentials.

# 1. PostgreSQL Database URL (Ephemeral SQLite files are not supported in Render production deployments)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://username:password@hostname:5432/databasename?schema=public"

# 2. Cryptographically secure dynamic session secret key
# Generate a secure random string of at least 32 characters (e.g. openssl rand -base64 32)
# Throw-on-startup validation is active: this MUST be set in production!
ADMIN_SESSION_SECRET="your-extremely-secure-32-character-session-secret-goes-here"

# 3. Default administrator credentials auto-seeding password
# If the live database's 'Admin' table is found empty on startup, the application
# will auto-seed username 'admin' using this password. Leave blank/unset to disable auto-seeding.
ADMIN_PASSWORD="your-secure-admin-portal-password-goes-here"

# 4. Node Environment State
NODE_ENV="production"
